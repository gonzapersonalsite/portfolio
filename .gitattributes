# From the agentic scaffold: defaults first; the rules below, the repository's, win.
*.bat text eol=crlf

# LF in the repository and in every working tree, whatever core.autocrlf says on the machine.
# Browsers hash inline scripts after normalising line breaks to LF, so the CSP hash in
# frontend/vercel.json only matches an index.html checked out with LF.
* text=auto eol=lf

# Binary assets: never converted, never diffed as text.
*.webp binary
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.woff2 binary
*.pdf binary
