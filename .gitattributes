# LF in the repository and in every working tree, whatever core.autocrlf says on the machine.
# Browsers hash inline scripts after normalising line breaks to LF, so the CSP hash in
# frontend/vercel.json only matches an index.html checked out with LF.
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets: never converted, never diffed as text.
*.webp binary
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.woff2 binary
*.pdf binary

# The scaffold under tools/ is development tooling written in Python, not the product:
# without this GitHub counts it and reports the repository as a Python project.
tools/** linguist-vendored
verify.py linguist-vendored
