#!/usr/bin/env sh
# pre-push: checks pushed refs and working tree (before and after gates) via
# host Git snapshot + containerized pre_push.py, and runs the project's gates
# through the same public launcher entry (`dev verify`). No host Python
# required. Activate once per clone:
#   git config core.hooksPath .githooks
# git push --no-verify skips it, and nothing records that it happened.
set -eu
HOOKS="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
ROOT="$(CDPATH= cd -- "$HOOKS/.." && pwd)"
if [ -f /.dockerenv ] && [ "${DEV_IN_CONTAINER:-}" = "1" ]; then
  cd "$ROOT"
  exec python3 tools/board/pre_push.py
fi
exec sh "$ROOT/tools/launcher/dev.sh" pre-push
