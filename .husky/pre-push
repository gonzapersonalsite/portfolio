#!/bin/sh
set -eu

zero="0000000000000000000000000000000000000000"
head_sha="$(git rev-parse --verify HEAD)"
has_push=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "${local_sha:-}" ] && continue
  if [ "$local_sha" = "$zero" ]; then
    continue
  fi
  has_push=1
  commit_sha="$(git rev-parse --verify "${local_sha}^{commit}" 2>/dev/null || true)"
  if [ "$commit_sha" != "$head_sha" ]; then
    echo "pre-push: $local_ref ($local_sha) does not match HEAD ($head_sha); checkout the commit you are pushing first." >&2
    exit 1
  fi
done

if [ "$has_push" -eq 0 ]; then
  exit 0
fi

if [ -n "$(git status --porcelain=v1 --untracked-files=all)" ]; then
  echo "pre-push: working tree has uncommitted or untracked files; commit or clean them so verification matches the pushed commit." >&2
  exit 1
fi

(
  cd frontend
  pnpm install --frozen-lockfile --prefer-offline
  pnpm lint
  pnpm test
  pnpm build
)

if [ "$(git rev-parse --verify HEAD)" != "$head_sha" ] || [ -n "$(git status --porcelain=v1 --untracked-files=all)" ]; then
  echo "pre-push: working tree or HEAD changed during verification; push rejected." >&2
  exit 1
fi
