#!/usr/bin/env sh
# commit-msg: checks the commit message before the commit exists, running
# tools/board/commit_message.py inside the pinned scaffold container (no host
# Python required). Activated with pre-push once per clone:
#   git config core.hooksPath .githooks
# git commit --no-verify skips it, and nothing records that it happened.
set -eu
HOOKS="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
ROOT="$(CDPATH= cd -- "$HOOKS/.." && pwd)"
if [ -f /.dockerenv ] && [ "${DEV_IN_CONTAINER:-}" = "1" ]; then
  cd "$ROOT"
  exec python3 tools/board/commit_message.py - "$1" < "$1"
fi
exec sh "$ROOT/tools/launcher/dev.sh" check-commit-msg "$1" < "$1"
